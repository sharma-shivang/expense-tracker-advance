{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix server install",
    "dev": "concurrently -n server,client -c blue,green \"npm --prefix server run dev\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "seed": "npm --prefix server run seed --",
    "unseed": "npm --prefix server run unseed --",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start:server": "npm --prefix server start",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0"
  }
}
